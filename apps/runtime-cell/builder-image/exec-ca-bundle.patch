diff --git a/executor/oci/execca.go b/executor/oci/execca.go
new file mode 100644
index 0000000..c175bfb
--- /dev/null
+++ b/executor/oci/execca.go
@@ -0,0 +1,66 @@
+package oci
+
+import (
+	"context"
+	"os"
+
+	"github.com/containerd/containerd/v2/core/containers"
+	"github.com/containerd/containerd/v2/pkg/oci"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"github.com/pkg/errors"
+)
+
+// ExecCABundleTarget is where an exec sees the worker's CA bundle
+// (worker.oci execCABundle): next to the SSH agent sockets BuildKit already
+// mounts under /run/buildkit, and removed from the rootfs with the other
+// mount stubs, so it never reaches a layer.
+const ExecCABundleTarget = "/run/buildkit/ca-bundle.pem"
+
+// ExecCABundleEnv are the variables the usual TLS stacks read a CA bundle
+// from: OpenSSL, Go, Python's ssl, Ruby and curl (SSL_CERT_FILE), Node (adds
+// NODE_EXTRA_CA_CERTS to its own roots), requests (REQUESTS_CA_BUNDLE), pip
+// (PIP_CERT), curl (CURL_CA_BUNDLE) and git (GIT_SSL_CAINFO).
+var ExecCABundleEnv = []string{"SSL_CERT_FILE", "NODE_EXTRA_CA_CERTS", "REQUESTS_CA_BUNDLE", "PIP_CERT", "CURL_CA_BUNDLE", "GIT_SSL_CAINFO"}
+
+// CheckExecCABundle reports whether bundle is a regular file the worker can
+// read, so a misconfigured worker fails when it starts, not on every exec.
+func CheckExecCABundle(bundle string) error {
+	st, err := os.Stat(bundle)
+	if err != nil {
+		return errors.Wrap(err, "execCABundle")
+	}
+	if !st.Mode().IsRegular() {
+		return errors.Errorf("execCABundle %s is not a regular file", bundle)
+	}
+	return nil
+}
+
+// WithExecCABundle mounts bundle read-only at ExecCABundleTarget.
+func WithExecCABundle(bundle string) oci.SpecOpts {
+	return func(_ context.Context, _ oci.Client, _ *containers.Container, s *specs.Spec) error {
+		s.Mounts = append(s.Mounts, specs.Mount{
+			Destination: ExecCABundleTarget,
+			Type:        "bind",
+			Source:      bundle,
+			Options:     []string{"rbind", "ro"},
+		})
+		return nil
+	}
+}
+
+// AppendExecCABundleEnv points the ExecCABundleEnv variables the exec has not
+// set at ExecCABundleTarget. A value the image or the build set (an ENV, a
+// build arg) wins, as for the tracing variables: that exec keeps the trust it
+// asked for.
+func AppendExecCABundleEnv(env []string) []string {
+	set := make(map[string]struct{}, len(env))
+	for _, e := range env {
+		set[envName(e)] = struct{}{}
+	}
+	for _, name := range ExecCABundleEnv {
+		if _, ok := set[name]; !ok {
+			env = append(env, name+"="+ExecCABundleTarget)
+		}
+	}
+	return env
+}
diff --git a/executor/oci/execca_test.go b/executor/oci/execca_test.go
new file mode 100644
index 0000000..90380bd
--- /dev/null
+++ b/executor/oci/execca_test.go
@@ -0,0 +1,46 @@
+package oci
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"github.com/stretchr/testify/require"
+)
+
+// An exec that set none of the variables gets each pointed at the bundle;
+// one the image or the build set keeps its value.
+func TestExecCABundleEnv(t *testing.T) {
+	got := AppendExecCABundleEnv([]string{"PATH=/usr/bin"})
+	require.Equal(t, "PATH=/usr/bin", got[0])
+	for _, name := range ExecCABundleEnv {
+		require.Contains(t, got, name+"="+ExecCABundleTarget)
+	}
+	require.Len(t, got, 1+len(ExecCABundleEnv))
+
+	got = AppendExecCABundleEnv([]string{"NODE_EXTRA_CA_CERTS=/corp/ca.pem", "SSL_CERT_FILE="})
+	require.Contains(t, got, "NODE_EXTRA_CA_CERTS=/corp/ca.pem")
+	require.NotContains(t, got, "NODE_EXTRA_CA_CERTS="+ExecCABundleTarget)
+	require.Contains(t, got, "SSL_CERT_FILE=")
+	require.NotContains(t, got, "SSL_CERT_FILE="+ExecCABundleTarget)
+	require.Contains(t, got, "PIP_CERT="+ExecCABundleTarget)
+}
+
+// The bundle reaches the exec read-only, at the target the variables name.
+func TestExecCABundleMount(t *testing.T) {
+	s := &specs.Spec{}
+	require.NoError(t, WithExecCABundle("/etc/kodus/ca-bundle.pem")(context.Background(), nil, nil, s))
+	require.Equal(t, []specs.Mount{{Destination: ExecCABundleTarget, Type: "bind", Source: "/etc/kodus/ca-bundle.pem", Options: []string{"rbind", "ro"}}}, s.Mounts)
+}
+
+// A worker configured with a bundle it cannot read does not start.
+func TestExecCABundleCheck(t *testing.T) {
+	dir := t.TempDir()
+	f := filepath.Join(dir, "ca.pem")
+	require.NoError(t, os.WriteFile(f, []byte("-----BEGIN CERTIFICATE-----\n"), 0o644))
+	require.NoError(t, CheckExecCABundle(f))
+	require.Error(t, CheckExecCABundle(filepath.Join(dir, "missing.pem")))
+	require.Error(t, CheckExecCABundle(dir))
+}
