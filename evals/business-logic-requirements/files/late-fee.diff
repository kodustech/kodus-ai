diff --git a/src/loans/lateFee.ts b/src/loans/lateFee.ts
new file mode 100644
--- /dev/null
+++ b/src/loans/lateFee.ts
@@ -0,0 +1,7 @@
+export const FEE_PER_DAY = 0.5;
+export const MAX_FEE = 10;
+export function lateFee(dueDate: Date, returnedAt: Date): number {
+  const days = Math.ceil((returnedAt.getTime() - dueDate.getTime()) / 86_400_000);
+  if (days <= 0) return 0;
+  return Math.min(days * FEE_PER_DAY, MAX_FEE);
+}
