diff --git a/src/invoices/reminders.ts b/src/invoices/reminders.ts
new file mode 100644
--- /dev/null
+++ b/src/invoices/reminders.ts
@@ -0,0 +1,6 @@
+import { queue } from '../queue';
+export async function scheduleInvoiceReminder(invoice: { id: string; dueDate: Date; paidAt: Date | null }) {
+  if (invoice.paidAt) return;
+  const at = new Date(invoice.dueDate.getTime() + 7 * 86_400_000);
+  await queue.add('invoice-reminder', { invoiceId: invoice.id }, { at });
+}
