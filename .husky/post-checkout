# $3 = 1 means branch checkout; 0 means file checkout. Only the former
# changes git state in a way that can move .env.schema, so skip file
# checkouts to keep `git checkout <file>` cheap.
# `if`, not `&&`: a false test would make the hook exit 1 on every file checkout.
if [ "$3" = "1" ]; then ./scripts/dev/check-env-drift.sh "$1" "$2"; fi
