# syntax=docker/dockerfile:1.7
# Multi-stage production build for kodus-web (Next.js)
# Used for both cloud production and QA builds.
#
# Build context: the monorepo root (NOT apps/web).
# This is required because apps/web imports from `@libs/feature-gate/*`,
# which resolves to `../../libs/*` via tsconfig paths. With the historical
# `apps/web` context, the build couldn't see those files. The web's
# `outputFileTracingRoot` is also pinned to the monorepo root, so the
# standalone output uses repo-relative paths.

# 1) Builder stage: install all deps and build
FROM docker.io/library/node:22.22.2-slim AS builder
WORKDIR /usr/src/app

ARG RELEASE_VERSION=local
ENV RELEASE_VERSION=${RELEASE_VERSION}

# pnpm via corepack — a versão é pinada pelo campo `packageManager` em
# apps/web/package.json.
RUN corepack enable

# Install web deps first so the cache layer stays warm even if other
# parts of the monorepo change. apps/web é um projeto pnpm ISOLADO: seu
# próprio pnpm-workspace.yaml fixa nodeLinker/overrides/allowBuilds e o
# mantém fora do workspace pnpm do backend (o monorepo não usa workspaces
# para o front).
COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./apps/web/

RUN --mount=type=cache,target=/pnpm-store,sharing=private \
    cd apps/web && pnpm install --frozen-lockfile --store-dir=/pnpm-store

# Copy only what the Next build actually needs:
#   - apps/web — the app itself
#   - libs/feature-gate — imported via `@libs/*` tsconfig path
#   - libs/identity/domain/permissions — the RBAC centralization
#     (7fedaf5ce) made apps/web import the shared Role enum + role-policies
#     from here (@libs/identity/domain/permissions/{enums,policies}). Only
#     this subtree is reachable from the web (the enum imports nothing;
#     role-policies imports only the enum), so we copy just it — the rest of
#     libs/identity pulls @nestjs/@casl and would break the isolated build.
#   - libs/llm/llm-tasks.ts — the BYOK routing UI imports the task taxonomy
#     (LLM_TASK / LlmTask) and the inheritance map (TASK_ROUTING_FALLBACK) from
#     this zero-dependency leaf, the single source of truth shared with the
#     backend resolver. It's the ONLY llm file the web reaches (it imports
#     nothing), so we copy just the file — never the rest of libs/llm, which
#     pulls the AI SDK / providers / kernel and would break the isolated build.
#   - release/features-snapshot.json — read at runtime by the lib loader
# Anything else in the repo (apps/api, libs/code-review, etc.) would just
# bloat the build context without being touched by Next.
COPY apps/web ./apps/web
COPY libs/feature-gate ./libs/feature-gate
COPY libs/identity/domain/permissions ./libs/identity/domain/permissions
COPY libs/llm/llm-tasks.ts ./libs/llm/llm-tasks.ts
COPY release/features-snapshot.json ./release/features-snapshot.json

WORKDIR /usr/src/app/apps/web
# Turbopack persists its compiler artifacts to .next/cache, and since Next 16.3
# that filesystem cache is on by default for `next build` too. Reusing it takes
# the compile step from ~57s cold to ~9s after a source change (measured on this
# app), so the mount keeps the directory alive across builds of this stage.
#
# Caveat: this only pays off where the BuildKit builder persists — local builds
# (docker-compose.bench.yml) or a self-hosted runner. The prod/QA workflows run
# `docker build` on ephemeral ubuntu-latest with a fresh builder, so the mount
# is empty there every run, and cache mounts are not carried by layer-cache
# export (`--cache-to type=gha`). Same limitation as the /pnpm-store mount above.
#
# `sharing=private` so two concurrent builds get separate caches instead of
# racing on one. Nothing from here reaches the runtime image — the production
# stage copies only .next/standalone, .next/static and public/.
RUN --mount=type=cache,target=/usr/src/app/apps/web/.next/cache,sharing=private \
    pnpm build

# 2) Production stage: only the final artifacts
FROM docker.io/library/node:22.22.2-slim AS production

RUN --mount=type=cache,target=/var/cache/apt,sharing=private \
    --mount=type=cache,target=/var/lib/apt,sharing=private \
    rm -f /etc/apt/apt.conf.d/docker-clean \
  && apt-get update \
  && apt-get install -y --no-install-recommends curl

WORKDIR /usr/src/app

ENV NODE_ENV=production
ENV WEB_NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# `next build` with `outputFileTracingRoot=<monorepo-root>` emits the
# standalone bundle under apps/web/.next/standalone/, with file paths
# relative to that tracing root. The bundle's entry is at
# `apps/web/server.js`, with required `node_modules/` and traced libs/
# laid out alongside.
COPY --from=builder --chown=1000:1000 /usr/src/app/apps/web/.next/standalone ./
COPY --from=builder --chown=1000:1000 /usr/src/app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=1000:1000 /usr/src/app/apps/web/public ./apps/web/public

USER 1000

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
