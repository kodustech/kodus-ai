  "mirrorBuildArgs": {
    "about": "The build args the cell passes every image build with its read-only mirror (docs/runtime/egress-allowlist.md §16): a build reaches registries only through it. A Dockerfile uses one only when it declares the ARG; Kody's recipe author declares them in each stage that installs. npm reads npm_config_*, pnpm pnpm_config_*, Yarn Berry YARN_<SETTING> (with HTTP allowed for the mirror's host), pip PIP_<OPTION>, uv UV_DEFAULT_INDEX and UV_INSECURE_HOST. artifacts are the tools that download a known build artifact (Prisma engines, MongoDB test binaries) and honor a mirror variable: the cell serves only a fixed list of them under /artifacts/ (§17).",
    "npm": ["npm_config_registry", "pnpm_config_registry", "YARN_NPM_REGISTRY_SERVER", "YARN_UNSAFE_HTTP_WHITELIST"],
    "pypi": ["PIP_INDEX_URL", "PIP_TRUSTED_HOST", "UV_DEFAULT_INDEX", "UV_INSECURE_HOST"],
    "go": ["GOPROXY"],
    "artifacts": ["PRISMA_ENGINES_MIRROR", "MONGOMS_DOWNLOAD_MIRROR"]
  },
  "recommended": {
    "version": 2,
    "entries": [
      { "host": "registry.npmjs.org", "ecosystem": "npm", "tier": "mirror", "paths": ["/"], "exceptPaths": ["/-/"], "why": "npm packages", "doc": "https://docs.npmjs.com/cli/v10/using-npm/registry", "since": 1 },
      { "host": "registry.yarnpkg.com", "ecosystem": "npm", "tier": "mirror", "paths": ["/"], "exceptPaths": ["/-/"], "untrusted": "refuse", "why": "Yarn's npm registry front (yarn v1 publishes here)", "doc": "https://classic.yarnpkg.com/en/docs/cli/config", "since": 1 },
      { "host": "repo.yarnpkg.com", "ecosystem": "npm", "tier": "inspected", "paths": ["/"], "build": "passthrough", "why": "Yarn's own releases (corepack)", "doc": "https://yarnpkg.com/corepack", "since": 1 },
      { "host": "pypi.org", "ecosystem": "pypi", "tier": "mirror", "paths": ["/simple/", "/pypi/"], "why": "PyPI index", "doc": "https://warehouse.pypa.io/api-reference/", "since": 1 },
      { "host": "files.pythonhosted.org", "ecosystem": "pypi", "tier": "mirror", "paths": ["/packages/"], "build": "passthrough", "why": "PyPI files", "doc": "https://warehouse.pypa.io/api-reference/", "since": 1 },
      { "host": "proxy.golang.org", "ecosystem": "go", "tier": "mirror", "paths": ["/"], "build": "passthrough", "why": "Go modules (the cell's Go mirror)", "doc": "https://go.dev/ref/mod#goproxy-protocol", "since": 1 },
      { "host": "sum.golang.org", "ecosystem": "go", "tier": "mirror", "paths": ["/lookup/", "/tile/", "/latest"], "build": "passthrough", "why": "Go checksum database", "doc": "https://go.dev/ref/mod#checksum-database", "since": 1 },
      { "host": "registry-1.docker.io", "ecosystem": "oci", "tier": "mirror", "paths": ["/v2/"], "why": "Docker Hub (the cell's image mirror)", "doc": "https://distribution.github.io/distribution/spec/api/", "since": 1 },
      { "host": "auth.docker.io", "ecosystem": "oci", "tier": "mirror", "paths": ["/token"], "why": "Docker Hub token service", "doc": "https://distribution.github.io/distribution/spec/auth/token/", "since": 1 },
      { "host": "production.cloudfront.docker.com", "ecosystem": "oci", "tier": "mirror", "paths": ["/"], "build": "passthrough", "why": "Docker Hub layers", "doc": "https://docs.docker.com/docker-hub/", "since": 1 },
      { "host": "deb.debian.org", "ecosystem": "apt", "tier": "mirror", "paths": ["/"], "build": "passthrough", "why": "Debian packages", "doc": "https://deb.debian.org/", "since": 1 },
      { "host": "security.debian.org", "ecosystem": "apt", "tier": "mirror", "paths": ["/"], "build": "passthrough", "why": "Debian security updates", "doc": "https://www.debian.org/security/", "since": 1 },
      { "host": "archive.ubuntu.com", "ecosystem": "apt", "tier": "mirror", "paths": ["/"], "build": "passthrough", "why": "Ubuntu packages", "doc": "https://help.ubuntu.com/community/Repositories", "since": 1 },
      { "host": "security.ubuntu.com", "ecosystem": "apt", "tier": "mirror", "paths": ["/"], "build": "passthrough", "why": "Ubuntu security updates", "doc": "https://help.ubuntu.com/community/Repositories", "since": 1 },
      { "host": "ports.ubuntu.com", "ecosystem": "apt", "tier": "mirror", "paths": ["/"], "build": "passthrough", "why": "Ubuntu packages for arm64", "doc": "https://help.ubuntu.com/community/Repositories", "since": 1 },
      { "host": "dl-cdn.alpinelinux.org", "ecosystem": "apk", "tier": "mirror", "paths": ["/"], "build": "passthrough", "why": "Alpine packages", "doc": "https://wiki.alpinelinux.org/wiki/Repositories", "since": 1 },
      { "host": "github.com", "ecosystem": "github", "tier": "inspected", "paths": ["/*/*/releases/download/", "/*/*/archive/"], "untrusted": "refuse", "why": "GitHub release and archive downloads; git and the API stay out", "doc": "https://docs.github.com/en/copilot/reference/copilot-allowlist-reference", "since": 1 },
      { "host": "codeload.github.com", "ecosystem": "github", "tier": "inspected", "paths": ["/"], "build": "passthrough", "why": "GitHub archive downloads", "doc": "https://docs.github.com/en/copilot/reference/copilot-allowlist-reference", "since": 1 },
      { "host": "objects.githubusercontent.com", "ecosystem": "github", "tier": "inspected", "paths": ["/"], "build": "passthrough", "why": "GitHub release assets", "doc": "https://docs.github.com/en/copilot/reference/copilot-allowlist-reference", "since": 1 },
      { "host": "release-assets.githubusercontent.com", "ecosystem": "github", "tier": "inspected", "paths": ["/"], "build": "passthrough", "why": "GitHub release assets", "doc": "https://docs.github.com/en/copilot/reference/copilot-allowlist-reference", "since": 1 },
      { "host": "cdn.sheetjs.com", "ecosystem": "cdn", "tier": "inspected", "paths": ["/xlsx-"], "build": "passthrough", "why": "SheetJS publishes xlsx on its CDN; its npm package is out of date (D1)", "doc": "https://docs.sheetjs.com/docs/getting-started/installation/nodejs", "since": 1 },
      { "host": "cdn.playwright.dev", "ecosystem": "browsers", "tier": "inspected", "paths": ["/"], "build": "passthrough", "why": "Playwright browsers for tests", "doc": "https://playwright.dev/docs/browsers", "since": 1 },
      { "host": "fonts.googleapis.com", "ecosystem": "fonts", "tier": "inspected", "paths": ["/css"], "build": "passthrough", "why": "Google Fonts stylesheets: next/font/google downloads them at next build", "doc": "https://nextjs.org/docs/app/api-reference/components/font", "since": 2 },
      { "host": "fonts.gstatic.com", "ecosystem": "fonts", "tier": "inspected", "paths": ["/s/"], "build": "passthrough", "why": "Google Fonts files the stylesheets name", "doc": "https://developers.google.com/fonts/docs/css2", "since": 2 }
    ]
