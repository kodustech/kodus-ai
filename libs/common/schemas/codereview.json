{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "version": {
            "type": "string",
            "default": "1.2",
            "description": "The version of the schema."
        },
        "summary": {
            "type": "object",
            "properties": {
                "generatePRSummary": {
                    "type": "boolean",
                    "default": true,
                    "description": "Indicates whether to generate a summary for the pull request."
                },
                "customInstructions": {
                    "type": "string",
                    "default": "",
                    "description": "Custom instructions for the pull request review."
                },
                "behaviourForExistingDescription": {
                    "type": "string",
                    "enum": ["replace", "concatenate", "complement"],
                    "default": "concatenate",
                    "description": "Defines how to handle existing descriptions."
                },
                "behaviourForNewCommits": {
                    "type": "string",
                    "enum": ["none", "replace", "concatenate"],
                    "default": "none",
                    "description": "Defines how Kody updates the summary when new commits arrive."
                }
            },
            "required": [
                "generatePRSummary",
                "customInstructions",
                "behaviourForExistingDescription",
                "behaviourForNewCommits"
            ],
            "additionalProperties": false
        },
        "ignorePaths": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": [
                "yarn.lock",
                "package-lock.json",
                "package.json",
                ".env",
                "**/*.json"
            ],
            "description": "List of file paths to ignore during the review."
        },
        "baseBranches": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": [],
            "description": "List of base branches for the pull request."
        },
        "reviewOptions": {
            "type": "object",
            "properties": {
                "security": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable security checks during the review."
                },
                "code_style": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable code style checks during the review."
                },
                "kody_rules": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Kody rules checks during the review."
                },
                "refactoring": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable refactoring checks during the review."
                },
                "error_handling": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable error handling checks during the review."
                },
                "maintainability": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable maintainability checks during the review."
                },
                "potential_issues": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable checks for potential issues during the review."
                },
                "documentation_and_comments": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable checks for documentation and comments during the review."
                },
                "performance_and_optimization": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable performance and optimization checks during the review."
                },
                "breaking_changes": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable checks for breaking changes during the review."
                }
            },
            "required": [
                "security",
                "code_style",
                "kody_rules",
                "refactoring",
                "error_handling",
                "maintainability",
                "potential_issues",
                "documentation_and_comments",
                "performance_and_optimization",
                "breaking_changes"
            ],
            "additionalProperties": false
        },
        "suggestionControl": {
            "type": "object",
            "properties": {
                "groupingMode": {
                    "type": "string",
                    "enum": ["minimal", "full"],
                    "default": "full",
                    "description": "Defines the grouping mode for suggestions."
                },
                "limitationType": {
                    "type": "string",
                    "enum": ["file", "pr", "severity"],
                    "default": "pr",
                    "description": "Defines the limitation type for suggestions."
                },
                "maxSuggestions": {
                    "type": "integer",
                    "default": 9,
                    "minimum": 9,
                    "description": "Maximum number of suggestions to provide."
                },
                "severityLevelFilter": {
                    "type": "string",
                    "enum": ["critical", "high", "medium", "low"],
                    "default": "medium",
                    "description": "Filter for the severity level of suggestions."
                },
                "applyFiltersToKodyRules": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to apply all filters (severity and quantity) to Kody Rules. When false, Kody Rules ignore all filters."
                },
                "severityLimits": {
                    "type": "object",
                    "properties": {
                        "low": {
                            "type": "integer",
                            "default": 0,
                            "minimum": 0,
                            "description": "Maximum number of low severity suggestions."
                        },
                        "medium": {
                            "type": "integer",
                            "default": 0,
                            "minimum": 0,
                            "description": "Maximum number of medium severity suggestions."
                        },
                        "high": {
                            "type": "integer",
                            "default": 0,
                            "minimum": 0,
                            "description": "Maximum number of high severity suggestions."
                        },
                        "critical": {
                            "type": "integer",
                            "default": 0,
                            "minimum": 0,
                            "description": "Maximum number of critical severity suggestions."
                        }
                    },
                    "required": ["low", "medium", "high", "critical"],
                    "additionalProperties": false,
                    "description": "Limits for suggestions by severity level. Only used when limitationType is 'severity'."
                }
            },
            "required": [
                "groupingMode",
                "limitationType",
                "maxSuggestions",
                "severityLevelFilter"
            ],
            "additionalProperties": false,
            "if": {
                "properties": {
                    "limitationType": {
                        "const": "file"
                    }
                }
            },
            "then": {
                "properties": {
                    "maxSuggestions": {
                        "maximum": 20
                    }
                }
            },
            "else": {
                "properties": {}
            }
        },
        "ignoredTitleKeywords": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "default": [],
            "description": "List of keywords to ignore in the title."
        },
        "automatedReviewActive": {
            "type": "boolean",
            "default": true,
            "description": "Indicates whether automated review processes are currently active. A value of true means that automated reviews are enabled, while false means they are disabled."
        },
        "showStatusFeedback": {
            "type": "boolean",
            "default": true,
            "description": "Indicates whether Kody should send skip/error status feedback using emoji reactions or comments."
        },
        "pullRequestApprovalActive": {
            "type": "boolean",
            "default": false,
            "description": "Indicates whether pull request approvals are currently active. A value of true means that pull request approvals are enabled, while false means they are disabled."
        },
        "isRequestChangesActive": {
            "type": "boolean",
            "default": false,
            "description": "Indicates whether to change status to 'Request Changes' if a critical suggestions is found."
        },
        "runOnDraft": {
            "type": "boolean",
            "default": true,
            "description": "Indicates whether the review should run on draft pull requests."
        },
        "reviewPolicy": {
            "type": "object",
            "description": "Versioned agent planning policy. Runtime validation applies safe bounds and rejects unsupported versions.",
            "properties": {
                "version": {
                    "type": "string",
                    "enum": ["1"]
                },
                "planner": {
                    "type": "object",
                    "properties": {
                        "strategy": {
                            "type": "string",
                            "enum": ["mode-compatible", "risk-based"]
                        },
                        "specialistRiskThreshold": {
                            "type": "number",
                            "minimum": 0
                        },
                        "largeChangeFiles": { "type": "integer", "minimum": 1 },
                        "largeChangeLines": { "type": "integer", "minimum": 1 }
                    },
                    "additionalProperties": false
                },
                "modes": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "fast": { "$ref": "#/definitions/reviewModePolicy" },
                        "normal": { "$ref": "#/definitions/reviewModePolicy" },
                        "deep": { "$ref": "#/definitions/reviewModePolicy" }
                    }
                }
            },
            "additionalProperties": false
        },
        "linkedRepositories": {
            "type": "array",
            "default": [],
            "maxItems": 10,
            "description": "Sibling repositories the agent may consult during review for cross-repo contract/boundary checks. Only repos connected to the same organization are accepted. Soft cap of 3 at review time. Empty = feature off.",
            "items": {
                "type": "object",
                "properties": {
                    "repository": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Full repository name (e.g. \"org/backend-api\")."
                    },
                    "instructions": {
                        "type": "string",
                        "description": "Optional hint for the agent about what this link is for."
                    },
                    "ref": {
                        "type": "string",
                        "description": "Optional ref pin. When omitted, cascade uses the PR head branch if it exists on the linked repo, otherwise the default branch."
                    }
                },
                "required": ["repository"],
                "additionalProperties": false
            }
        }
    },
    "definitions": {
        "reviewAgentBudget": {
            "type": "object",
            "properties": {
                "enabled": { "type": "boolean" },
                "maxSteps": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
        },
        "reviewModePolicy": {
            "type": "object",
            "properties": {
                "maxParallelAgents": { "type": "integer", "minimum": 1 },
                "agents": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "generalist": {
                            "$ref": "#/definitions/reviewAgentBudget"
                        },
                        "bug": { "$ref": "#/definitions/reviewAgentBudget" },
                        "security": {
                            "$ref": "#/definitions/reviewAgentBudget"
                        },
                        "performance": {
                            "$ref": "#/definitions/reviewAgentBudget"
                        },
                        "kody-rules": {
                            "$ref": "#/definitions/reviewAgentBudget"
                        }
                    }
                },
                "adaptiveBudget": {
                    "type": "object",
                    "properties": {
                        "baselineFiles": { "type": "integer", "minimum": 0 },
                        "stepsPerExtraFile": { "type": "number", "minimum": 0 },
                        "maxSteps": { "type": "integer", "minimum": 1 }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        }
    },
    "required": [
        "version",
        "summary",
        "ignorePaths",
        "baseBranches",
        "reviewOptions",
        "suggestionControl",
        "ignoredTitleKeywords",
        "automatedReviewActive",
        "pullRequestApprovalActive",
        "isRequestChangesActive",
        "runOnDraft"
    ],
    "additionalProperties": false
}
